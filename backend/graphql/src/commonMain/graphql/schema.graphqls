enum AppColour {
  Primary

  Quaternary

  Secondary

  Tertiary
}

type Chef {
  chef: ChefData!
}

type ChefBio {
  bio: String

  bylineImageUrl: String

  webUrl: String!

  bylineLargeImageUrl: String

  contributorId: String!

  webTitle: String!

  apiUrl: String

  """
  returns all recipes
  """
  recipes(limit: Int!, offset: Int, sortBy: recipeSortFields, sortDirection: recipeSortDirections, celebrations: [String!], cuisines: [String!], diets: [String!], mealTypes: [String!], techniques: [String!], utensilsAppliances: [String!], bylines: [String!]): [Recipe!]!
}

type ChefData {
  image: String

  bio: String

  foregroundHex: String

  backgroundHex: String

  id: String!

  """
  Background information about this chef
  """
  meta: ChefBio
}

"""
The type of this collection
"""
enum CollectionTypes {
  SAVED

  COOKED

  CUSTOM

  NOTES
}

"""
The content held within this collection
"""
enum ContentTypes {
  RECIPE

  NOTES

  COLLECTION
}

type CustomMessage {
  image: String!

  foregroundColor: AppColour!

  isDismissable: Boolean!

  title: String!

  size: PromptSize!

  isIcon: Boolean!

  showChevron: Boolean!

  backgroundColor: AppColour!

  ctaLabel: String

  supporting: String
}

type CustomMessageInsert {
  messages: [CustomMessage!]!
}

type FeastAppContainer {
  identityId: String

  targetedRegions: [String!]

  title: String!

  id: uuid!

  body: String

  excludedRegions: [String!]

  items: [item!]!
}

type IndividualTiming {
  value: String!

  label: String!
}

type Insert {
  """
  What type of insert this is, indicating the content to be shown
  """
  insertType: String!
}

type KeywordStats {
  sumOtherDocCount: Int!

  docCountErrorUpperBound: Int!

  buckets: [StatBucket!]!
}

type KeywordSuggestionsInsert {
  keywordSuggestions: [SuggestedFilterResult!]!
}

"""
A timestamp in local format
"""
scalar LocalDateTime

"""
The original measuring system used in this recipe
"""
enum OriginalMeasuringSystem {
  METRIC

  US

  AUS

  IMPERIAL
}

type Palette {
  foregroundHex: String

  backgroundHex: String
}

type PrivateNote {
  collectionId: String

  firstPersistedAt: ZonedDateTime!

  owner: Int!

  noteText: String

  lastModified: ZonedDateTime!

  recipeId: String!

  pk: Int!
}

enum PromptSize {
  large

  small
}

type Query {
  """
  performs a recipe search and returns the results
  """
  search(pageSize: Int, page: Int, uprateByDate: SortableDates, cuisineFilter: [String!], contributorFilter: [String!], dietFilter: [String!], mealTypeFilter: [String!], celebrationFilter: [String!], sponsorFilter: [String!], enableCutOff: Boolean, q: String!, limit: Int): SearchResponse

  availableFilters: availableFilters!

  """
  returns a recipe with the specific unique id
  """
  recipe(id: String!): Recipe

  """
  returns all recipes
  """
  recipes(limit: Int!, offset: Int, sortBy: recipeSortFields, sortDirection: recipeSortDirections, celebrations: [String!], cuisines: [String!], diets: [String!], mealTypes: [String!], techniques: [String!], utensilsAppliances: [String!], contributors: [String!], bylines: [String!]): [Recipe!]!

  """
  returns curation ('fronts') information
  """
  curation(region: regions!, edition: editions!, date: date): [FeastAppContainer!]!

  """
  returns a specific curated container based on id
  """
  curatedContainerById(id: uuid!): FeastAppContainer

  """
  returns a specific curated container based on alias
  """
  curatedContainerByAlias(region: regions!, edition: editions!, date: date, alias: String!): FeastAppContainer

  """
  returns information about our chefs
  """
  chefs(limit: Int!, offset: Int): [contributor!]!

  """
  information about a specific chef
  """
  chef(id: String!): ChefBio

  """
  Items saved in the current user's personal collections
  """
  SavedCollections: [SavedCollection!]!
}

"""
A field containing a raw JSON object
"""
scalar RawJson

type Recipe {
  canonicalArticle: String

  bookCredit: String

  appExclusiveBranding: Boolean!

  lastModifiedDate: LocalDateTime

  title: String

  isAppReady: Boolean

  composerId: String

  checksumV2: String

  firstPublishedDate: LocalDateTime

  description: String

  originalMeasuringSystem: OriginalMeasuringSystem!

  id: String!

  difficultyLevel: String

  publishedDate: LocalDateTime

  ingredients: [ingredientSection!]!

  instructions: [instruction!]!

  serves: [serving!]!

  checksum: String!

  timings: [timing!]!

  featuredImage: image

  previewImage: image

  renderedTimings: renderedTimings

  """
  Information about the recipe author
  """
  contributors: [ChefBio!]!

  """
  Celebration IDs associated with this recipe
  """
  celebrations: [String!]!

  """
  Commerce CTA payloads associated with this recipe
  """
  commerceCtas: [RawJson!]!

  """
  Cuisine IDs associated with this recipe
  """
  cuisines: [String!]!

  """
  Diet IDs associated with this recipe
  """
  diets: [String!]!

  """
  Meal type IDs associated with this recipe
  """
  mealTypes: [String!]!

  """
  Technique IDs associated with this recipe
  """
  techniques: [String!]!

  """
  Utensil and appliance IDs associated with this recipe
  """
  utensilsAppliances: [String!]!

  """
  Sponsorship entries associated with this recipe
  """
  sponsorships: [SponsorData!]!

  """
  Any notes that the current user has saved against this recipe
  """
  userNotes: PrivateNote

  """
  List of the collections that the current user has saved this recipe into
  """
  savedIntoCollections: [SavedCollection!]!

  """
  The number of people who've saved this recipe
  """
  savedByCount: Int!
}

type RecipeReference {
  """
  the recipe data
  """
  recipe: Recipe
}

type SavedCollection {
  collectionId: String!

  collectionType: CollectionTypes!

  title: String!

  owner: Int!

  softDeleted: Boolean!

  lastModified: ZonedDateTime!

  pk: Int!

  contentType: ContentTypes!

  """
  Recipes saved to this collection
  """
  recipes(limit: Int!, offset: Int): [SavedRecipe!]!

  """
  Private Notes saved to this collection
  """
  privateNotes: [PrivateNote!]!

  """
  Extra metadata for the collection
  """
  meta: String
}

type SavedRecipe {
  collectionId: String

  firstPersistedAt: ZonedDateTime!

  lastModified: ZonedDateTime!

  """
  Content of the saved recipe
  """
  recipe: Recipe
}

type SearchHit {
  """
  Score of the result. The higher the number, the more relevant the result. Generally between 0 and 1
  """
  score: Float

  """
  a referenced recipe
  """
  recipe: Recipe!
}

type SearchResponse {
  stats: StatsSection

  maxScore: Float!

  """
  The results of the search
  """
  results: [SearchResult!]!
}

union SearchResult = SearchHit|Insert|KeywordSuggestionsInsert|CustomMessageInsert

"""
Specific date fields that can be used for reordering results
"""
enum SortableDates {
  """
  The last time a revision of the recipe (article) was published
  """
  publishedDate

  """
  The first time that this recipe (article) was published
  """
  firstPublishedDate

  """
  The last time a change was made to the block containing this recipe in its original article
  """
  lastModifiedDate
}

type SponsorData {
  highContrastSponsorLogo: String

  sponsorLogo: String!

  sponsorLogoWidth: Int

  sponsorshipType: String!

  highContrastSponsorLogoHeight: Int

  sponsorLogoHeight: Int

  sponsorName: String!

  sponsorLink: String!

  highContrastSponsorLogoWidth: Int
}

type StatBucket {
  key: String!

  docCount: Int!
}

type StatsSection {
  contributors: KeywordStats

  cuisineIds: KeywordStats

  mealTypeIds: KeywordStats

  bylines: KeywordStats

  suitableForDietIds: KeywordStats
}

type SubCollection {
  collection: SubCollectionData!
}

type SubCollectionData {
  image: String

  lightPalette: Palette

  byline: String

  darkPalette: Palette

  title: String!

  body: String

  """
  The recipes that make up this collection
  """
  recipes(sortBy: recipeSortFields, sortDirection: recipeSortDirections): [Recipe!]!
}

type SuggestedContributor {
  id: String!

  type: SuggestedFilterType!

  """
  Information about this chef
  """
  chef: ChefBio
}

type SuggestedFilter {
  id: String!

  type: SuggestedFilterType!
}

"""
Represents a filter that the user might want to apply. If a contributor it allows the whole of the contributor's information
"""
union SuggestedFilterResult = SuggestedContributor|SuggestedFilter

enum SuggestedFilterType {
  Byline

  Celebration

  Contributor

  Cuisine

  MealType

  SuitableForDiet
}

"""
A timestamp with timezone attached
"""
scalar ZonedDateTime

"""
shows which values are available for search filtering in each category
"""
type availableFilters {
  """
  which diets a recipe is suitable for, for example vegetarian
  """
  dietIds(startAt: Int = 0, limit: Int = 20): [String!]!

  """
  collects recipes best suited to certain occasions, for example Christmas
  """
  celebrationIds(startAt: Int = 0, limit: Int = 20): [String!]!

  """
  collects recipes by their geographical origin
  """
  cuisineIds(startAt: Int = 0, limit: Int = 20): [String!]!

  """
  collects recipes by the part of a meal they are best suited for, for example starter or main course
  """
  mealTypeIds(startAt: Int = 0, limit: Int = 20): [String!]!

  """
  collects recipes by our main chefs. For more options see the `chef` root query type
  """
  contributorIds(startAt: Int = 0, limit: Int = 20, contains: String): [String!]!
}

type byline {
  """
  name of the chef
  """
  webTitle: String!

  """
  returns all recipes
  """
  recipes(limit: Int!, offset: Int, sortBy: recipeSortFields, sortDirection: recipeSortDirections, celebrations: [String!], cuisines: [String!], diets: [String!], mealTypes: [String!], techniques: [String!], utensilsAppliances: [String!], contributors: [String!], bylines: [String!]): [Recipe!]!
}

union contributor = ChefBio|byline

scalar date

"""
variations of the Feast curation published each day
"""
enum editions {
  """
  meaty and meat-free recipes
  """
  all

  """
  only meat-free recipes
  """
  meatfree
}

type image {
  """
  The direct URL to the image
  """
  url: String!

  """
  The unique identifier for the media
  """
  mediaId: String

  """
  The identifier for the specific crop used
  """
  cropId: String

  """
  The publication or source of the image
  """
  source: String

  """
  Whether it is mandatory for the credit to be displayed
  """
  displayCredit: Boolean

  """
  The credited photographer
  """
  photographer: String

  """
  The descriptive text accompanying the image
  """
  caption: String

  """
  The API endpoint URI for the media asset
  """
  mediaApiUri: String

  """
  The width of the image in pixels
  """
  width: Int!

  """
  The height of the image in pixels
  """
  height: Int!

  """
  A parameterized URL template for generating variants
  """
  templateUrl: String
}

type ingredient {
  """
  ingredient name
  """
  name: String!

  """
  original text
  """
  text: String!

  """
  unit abbreviation
  """
  unit: String

  """
  is the ingredient optional to the recipe
  """
  optional: Boolean!

  """
  template text for rendering
  """
  template: String
}

type ingredientSection {
  """
  title for this particular ingredient set
  """
  recipeSection: String

  """
  list of ingredients
  """
  ingredientsList: [ingredient!]!
}

type instruction {
  """
  the text of the method step
  """
  description: String!

  """
  the method step with convertible templates
  """
  descriptionTemplate: String
}

union item = SubCollection|Chef|RecipeReference

type minmax {
  """
  Maximum
  """
  max: Float

  """
  Minimum
  """
  min: Float
}

"""
valid recipe sort directions
"""
enum recipeSortDirections {
  asc

  desc
}

"""
valid recipe sort fields
"""
enum recipeSortFields {
  title

  publishedDate

  firstPublishedDate

  lastModifiedDate
}

"""
available Feast curation regions
"""
enum regions {
  """
  curation for the northern hemisphere
  """
  northern

  """
  curation for the southern hemisphere
  """
  southern

  """
  curation for the USA
  """
  us
}

type renderedTimings {
  """
  The recipe timings rendered for preview cards
  """
  forCard: String

  """
  The recipe timings rendered for recipe pages
  """
  forRecipe: [IndividualTiming!]!
}

type serving {
  """
  original text of the serving
  """
  text: String!

  """
  what is the quantity measuring
  """
  unit: String
}

type timing {
  """
  original recipe text
  """
  text: String

  """
  the type of timing
  """
  qualifier: String

  """
  the duration
  """
  durationInMins: minmax!
}

scalar uuid

"""
A Directive provides a way to describe alternate runtime execution and type validation behavior in a GraphQL document.

In some cases, you need to provide options to alter GraphQL’s execution behavior in ways field arguments will not suffice, such as conditionally including or skipping a field. Directives provide this by describing additional information to the executor.
"""
type __Directive {
  name: String!

  description: String

  locations: [__DirectiveLocation!]!

  args(includeDeprecated: Boolean = false): [__InputValue!]!

  """
  Permits using the directive multiple times at the same location.
  """
  isRepeatable: Boolean!
}

"""
A Directive can be adjacent to many parts of the GraphQL language, a __DirectiveLocation describes one such possible adjacencies.
"""
enum __DirectiveLocation {
  """
  Location adjacent to a query operation.
  """
  QUERY

  """
  Location adjacent to a mutation operation.
  """
  MUTATION

  """
  Location adjacent to a subscription operation.
  """
  SUBSCRIPTION

  """
  Location adjacent to a field.
  """
  FIELD

  """
  Location adjacent to a fragment definition.
  """
  FRAGMENT_DEFINITION

  """
  Location adjacent to a fragment spread.
  """
  FRAGMENT_SPREAD

  """
  Location adjacent to an inline fragment.
  """
  INLINE_FRAGMENT

  """
  Location adjacent to a variable definition.
  """
  VARIABLE_DEFINITION

  """
  Location adjacent to a schema definition.
  """
  SCHEMA

  """
  Location adjacent to a scalar definition.
  """
  SCALAR

  """
  Location adjacent to an object type definition.
  """
  OBJECT

  """
  Location adjacent to a field definition.
  """
  FIELD_DEFINITION

  """
  Location adjacent to an argument definition.
  """
  ARGUMENT_DEFINITION

  """
  Location adjacent to an interface definition.
  """
  INTERFACE

  """
  Location adjacent to a union definition.
  """
  UNION

  """
  Location adjacent to an enum definition.
  """
  ENUM

  """
  Location adjacent to an enum value definition.
  """
  ENUM_VALUE

  """
  INPUT_OBJECT
  """
  INPUT_OBJECT

  """
  Location adjacent to an input object field definition.
  """
  INPUT_FIELD_DEFINITION
}

"""
One possible value for a given Enum. Enum values are unique values, not a placeholder for a string or numeric value. However an Enum value is returned in a JSON response as a string.
"""
type __EnumValue {
  name: String!

  description: String

  isDeprecated: Boolean!

  deprecationReason: String
}

"""
Object and Interface types are described by a list of Fields, each of which has a name, potentially a list of arguments, and a return type.
"""
type __Field {
  name: String!

  description: String

  args(includeDeprecated: Boolean = false): [__InputValue!]!

  type: __Type!

  isDeprecated: Boolean!

  deprecationReason: String
}

"""
Arguments provided to Fields or Directives and the input fields of an InputObject are represented as Input Values which describe their type and optionally a default value.
"""
type __InputValue {
  name: String!

  description: String

  type: __Type!

  """
  A GraphQL-formatted string representing the default value for this input value.
  """
  defaultValue: String

  isDeprecated: Boolean

  deprecationReason: String
}

"""
A GraphQL Schema defines the capabilities of a GraphQL server. It exposes all available types and directives on the server, as well as the entry points for query, mutation, and subscription operations.
"""
type __Schema {
  description: String

  """
  A list of all types supported by this server.
  """
  types: [__Type!]!

  """
  The type that query operations will be rooted at.
  """
  queryType: __Type!

  """
  If this server supports mutation, the type that mutation operations will be rooted at.
  """
  mutationType: __Type

  """
  If this server support subscription, the type that subscription operations will be rooted at.
  """
  subscriptionType: __Type

  """
  A list of all directives supported by this server.
  """
  directives: [__Directive!]!
}

"""
The fundamental unit of any GraphQL Schema is the type. There are many kinds of types in GraphQL as represented by the `__TypeKind` enum.

Depending on the kind of a type, certain fields describe information about that type. Scalar types provide no information beyond a name and description, while Enum types provide their values. Object and Interface types provide the fields they describe. Abstract types, Union and Interface, provide the Object types possible at runtime. List and NonNull types compose other types.
"""
type __Type {
  kind: __TypeKind!

  name: String

  description: String

  fields(includeDeprecated: Boolean = false): [__Field!]

  interfaces: [__Type!]

  possibleTypes: [__Type!]

  enumValues(includeDeprecated: Boolean = false): [__EnumValue!]

  inputFields(includeDeprecated: Boolean = false): [__InputValue!]

  ofType: __Type
}

"""
An enum describing what kind of type a given `__Type` is.
"""
enum __TypeKind {
  """
  Indicates this type is a scalar.
  """
  SCALAR

  """
  Indicates this type is an object. `fields` and `interfaces` are valid fields.
  """
  OBJECT

  """
  Indicates this type is an interface. `fields` and `possibleTypes` are valid fields.
  """
  INTERFACE

  """
  Indicates this type is a union. `possibleTypes` is a valid field.
  """
  UNION

  """
  Indicates this type is an enum. `enumValues` is a valid field.
  """
  ENUM

  """
  Indicates this type is an input object. `inputFields` is a valid field.
  """
  INPUT_OBJECT

  """
  Indicates this type is a list. `ofType` is a valid field.
  """
  LIST

  """
  Indicates this type is a non-null. `ofType` is a valid field.
  """
  NON_NULL
}

"""
The `Boolean` scalar type represents `true` or `false`.
"""
scalar Boolean

"""
The `Float` scalar type represents signed double-precision fractional values as specified by [IEEE 754](https://en.wikipedia.org/wiki/IEEE_754).
"""
scalar Float

"""
The `Int` scalar type represents non-fractional signed whole numeric values. Int can represent values between -(2^31) and 2^31 - 1.
"""
scalar Int

"""
The `String` scalar type represents textual data, represented as UTF-8 character sequences. The String type is most often used by GraphQL to represent free-form human-readable text.
"""
scalar String

"""
Directs the executor to include this field or fragment only when the `if` argument is true.
"""
directive @include("Included when true." if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

"""
Directs the executor to skip this field or fragment when the `if` argument is true.
"""
directive @skip("Included when true." if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

"""
Marks an element of a GraphQL schema as no longer supported.
"""
directive @deprecated("Explains why this element was deprecated, usually also including a suggestion for how to access supported similar data. Formatted in [Markdown](https://daringfireball.net/projects/markdown/)." reason: String = "No longer supported") on ARGUMENT_DEFINITION | ENUM_VALUE | FIELD_DEFINITION | INPUT_FIELD_DEFINITION

"""
Indicates exactly one field must be supplied and this field must not be `null`.
"""
directive @oneOf on INPUT_OBJECT

schema {
  query: Query
}

